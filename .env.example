# Copy this file to ".env" and put your real key in it. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional — defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Local OCR fallback (used automatically when Gemini fails or hits quota).
# Needs the free Tesseract OCR engine installed on this machine — it's not
# a pip package. Docker/Railway already has it (see Dockerfile). For local
# Windows dev: `winget install UB-Mannheim.TesseractOCR`, then if it's not
# on PATH, point to it here:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_LANG=fra+eng
#
# The winget/silent installer only bundles English — no admin rights
# needed to add French: download fra.traineddata from
# https://github.com/tesseract-ocr/tessdata_fast into a local folder
# (e.g. ./tessdata_local, gitignored) alongside a copy of eng.traineddata
# from the Tesseract install dir, then point Tesseract at that folder:
# TESSDATA_PREFIX=C:\Users\you\path\to\isteps-invoice-demo\tessdata_local
